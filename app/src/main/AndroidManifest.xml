<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
    </queries>

    <application
        android:name="com.example.wavex.app.WaveXApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaveX"
        android:requestLegacyExternalStorage="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".feature.profile.presentation.downloads.presentation.DownloadedSongActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_downloaded_song"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.player.presentation.PlayerActivityScreen"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_player_screen"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.library.presentation.favourite.presentation.FavouriteSongActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_liked_songs_activity"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.library.presentation.playlist.presentation.PlaylistActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_playlist"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.presentation.playlists.presentation.PlaylistsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_playlists"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".feature.profile.presentation.settings.presentation.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_setting"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.presentation.albums.presentation.AlbumsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_albums"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.presentation.artists.presentation.ArtistsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_artists_activity"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.presentation.songs.presentation.FavouriteSongsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_favourite_songs"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.user.presentation.YourProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_your_profile"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.profile.presentation.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_profile"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.playlist.presentation.PlaylistActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_playlist_activity"
            android:theme="@style/Theme.WaveX" />

        <service
            android:name=".core.service.MusicPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|dataSync" />

        <service
            android:name=".core.service.WaveXFirebaseService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".feature.album.presentation.AlbumActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_album"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.artist.allalbums.presentation.AllAlbumsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_all_albums_screen"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.artist.allsongs.presentation.AllSongsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_all_songs"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.artist.presentation.ArtistActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_artist"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".MainScreen"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main_screen"
            android:theme="@style/Theme.WaveX"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="wavex-edd95.web.app"
                    android:pathPrefix="/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.auth.presentation.verifyemail.VerifyEmailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_verify_code"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.auth.presentation.forgotpassword.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_forgot_password"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.auth.presentation.signin.SignInActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_sign_in"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".feature.auth.presentation.signup.SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_sign_up"
            android:theme="@style/Theme.WaveX" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.WaveX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>